load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//bazel:js_test.bzl", "harness_js_test")

# The workflow histories replay_test replays. They come from live runs, so they are not generated
# by a build action: `bazel run :histories_update` re-records them on a dev server.
filegroup(
    name = "histories",
    testonly = True,
    srcs = glob(["histories/**/*.json"]),
)

ts_project(
    name = "bundles",
    testonly = True,
    srcs = ["bundles.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":scripted-demo",
        "//typescript/packages/worker:node_modules/@temporalio/worker",
        "//typescript/packages/worker/src:index",
        "//typescript/packages/worker/src/utils:large-payload",
        "//typescript/packages/worker/test:support",
    ],
)

ts_project(
    name = "record-histories",
    testonly = True,
    srcs = ["record-histories.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":bundles",
        ":scripted-demo-activities",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/client",
        "//typescript/packages/worker:node_modules/@temporalio/common",
        "//typescript/packages/worker:node_modules/@temporalio/worker",
        "//typescript/packages/worker:node_modules/@temporalio/workflow-streams",
        "//typescript/packages/worker/src/harness/code-mode:monty-stepper",
        "//typescript/packages/worker/test:support",
    ],
)

ts_project(
    name = "replay.test",
    testonly = True,
    srcs = ["replay.test.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":bundles",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/client",
        "//typescript/packages/worker:node_modules/@temporalio/common",
        "//typescript/packages/worker:node_modules/@temporalio/worker",
        "//typescript/packages/worker/test:support",
    ],
)

# The scripted demo agent, bundled by Temporal's worker at run time.
ts_project(
    name = "scripted-demo",
    testonly = True,
    srcs = ["scripted-demo.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/workflow",
        "//typescript/packages/worker:node_modules/zod",
    ],
)

ts_project(
    name = "scripted-demo-activities",
    testonly = True,
    srcs = ["scripted-demo-activities.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":scripted-demo",
        "//typescript/packages/worker/src:index",
    ],
)

# Re-records histories/ in the workspace from fresh runs on the pinned dev server.
js_binary(
    name = "histories_update",
    testonly = True,
    data = [
        ":record-histories",
        "//bazel/temporal:cli",
    ],
    entry_point = "record-histories.js",
    env = {"TEMPORAL_CLI_PATH": "$(rootpath //bazel/temporal:cli)"},
    no_copy_to_bin = ["//bazel/temporal:cli"],
)

harness_js_test(
    name = "replay_test",
    data = [
        ":histories",
        ":replay.test",
    ],
    entry_point = "replay.test.js",
)

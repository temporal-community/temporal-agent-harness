load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//bazel:js_test.bzl", "harness_js_test")

# Tests of core's observable state (src/harness/state), one target per file.
ts_project(
    name = "state-property.test",
    testonly = True,
    srcs = ["state-property.test.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":state-support",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/fast-check",
    ],
)

ts_project(
    name = "state-support",
    testonly = True,
    srcs = ["state-support.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness-client",
        "//typescript/packages/worker:node_modules/zod",
        "//typescript/packages/worker/test/fixtures:workflows",
    ],
)

ts_project(
    name = "state.test",
    testonly = True,
    srcs = ["state.test.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":state-support",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker/src/harness:agent-client",
        "//typescript/packages/worker/test:match",
        "//typescript/packages/worker/test:support",
    ],
)

js_test(
    name = "state-property_test",
    data = [":state-property.test"],
    entry_point = "state-property.test.js",
)

harness_js_test(
    name = "state_test",
    data = [":state.test"],
    entry_point = "state.test.js",
)

load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//bazel:js_test.bzl", "agent_kit_js_test")

# One target per test file and support module, depending on the files it imports.
ts_project(
    name = "match",
    testonly = True,
    srcs = ["match.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//typescript/packages/worker/test:__subpackages__"],
)

ts_project(
    name = "plugin.test",
    testonly = True,
    srcs = ["plugin.test.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":match",
        ":support",
        "//typescript/packages/worker:node_modules/@temporalio/agent-kit",
        "//typescript/packages/worker:node_modules/@temporalio/common",
        "//typescript/packages/worker:node_modules/@temporalio/worker",
        "//typescript/packages/worker/src:agent-client",
        "//typescript/packages/worker/src:index",
        "//typescript/packages/worker/src:plugin",
        "//typescript/packages/worker/test/fixtures:workflows",
    ],
)

ts_project(
    name = "support",
    testonly = True,
    srcs = ["support.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//typescript/packages/worker/test:__subpackages__"],
    deps = [
        "//typescript/packages/worker:node_modules/@temporalio/activity",
        "//typescript/packages/worker:node_modules/@temporalio/agent-kit",
        "//typescript/packages/worker:node_modules/@temporalio/client",
        "//typescript/packages/worker:node_modules/@temporalio/testing",
        "//typescript/packages/worker:node_modules/@temporalio/worker",
        "//typescript/packages/worker:node_modules/@temporalio/workflow-streams",
        "//typescript/packages/worker/src:agent-client",
        "//typescript/packages/worker/src:index",
        "//typescript/packages/worker/src/stream-merge:index",
        "//typescript/packages/worker/src/utils:large-payload",
        "//typescript/packages/worker/test/fixtures:workflows",
    ],
)

agent_kit_js_test(
    name = "plugin_test",
    data = [":plugin.test"],
    entry_point = "plugin.test.js",
)

js_test(
    name = "development_test",
    data = ["//typescript/packages/worker:development"],
    entry_point = "development.test.mjs",
)

# One target per test file (and per compile-time type check, *.types.ts), depending on the files it
# imports.
ts_project(
    name = "agent-client.test",
    testonly = True,
    srcs = ["agent-client.test.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        "//typescript/packages/worker:node_modules/@temporalio/agent-kit",
        "//typescript/packages/worker:node_modules/@temporalio/client",
        "//typescript/packages/worker:node_modules/@temporalio/workflow-streams",
        "//typescript/packages/worker/src:agent-client",
    ],
)

ts_project(
    name = "agent-client.types",
    testonly = True,
    srcs = ["agent-client.types.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        "//typescript/packages/worker/src:agent-client",
        "//typescript/packages/worker/test/fixtures:workflows",
    ],
)

js_test(
    name = "agent-client_test",
    data = [":agent-client.test"],
    entry_point = "agent-client.test.js",
)

ts_project(
    name = "agent.test",
    testonly = True,
    srcs = ["agent.test.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        "//typescript/packages/worker:node_modules/@temporalio/agent-kit",
        "//typescript/packages/worker:node_modules/@temporalio/common",
    ],
)

js_test(
    name = "agent_test",
    data = [":agent.test"],
    entry_point = "agent.test.js",
)

# agent-kit-schema (src/harness/agent-schema.ts), the bin this package publishes. One test runs
# it on a TypeScript source, as a user would, so agents.ts is a runfile too.
ts_project(
    name = "agent-schema.test",
    testonly = True,
    srcs = ["agent-schema.test.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        "//typescript/packages/worker:node_modules/@temporalio/agent-kit",
        "//typescript/packages/worker/src:agent-schema",
        "//typescript/packages/worker/test/serving:agents",
    ],
)

js_test(
    name = "agent-schema_test",
    data = [
        ":agent-schema.test",
        "//typescript/packages/worker/test/serving:agents_source",
    ],
    entry_point = "agent-schema.test.js",
)

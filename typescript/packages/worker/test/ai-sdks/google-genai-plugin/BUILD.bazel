load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//bazel:js_test.bzl", "harness_js_test")

# Tests of the Gemini integration (core's and the worker's ai-sdks/google-genai-plugin). One target
# per file.

# The probe agent tool-loop.test bundles, with the node_modules it imports as runfiles.
ts_project(
    name = "agents",
    testonly = True,
    srcs = ["agents.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/workflow",
        "//typescript/packages/worker:node_modules/zod",
    ],
)

ts_project(
    name = "errors.test",
    testonly = True,
    srcs = ["errors.test.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":script",
        "//typescript/packages/worker:node_modules/@google/genai",
        "//typescript/packages/worker:node_modules/@temporalio/common",
        "//typescript/packages/worker/src/ai-sdks/google-genai-plugin:index",
    ],
)

ts_project(
    name = "interactions-activity.test",
    testonly = True,
    srcs = ["interactions-activity.test.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":script",
        "//typescript/packages/worker:node_modules/@google/genai",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker/src/ai-sdks/google-genai-plugin:index",
        "//typescript/packages/worker/src/ai-sdks/integration-helpers:stream-observer",
        "//typescript/packages/worker/src/harness:agent-workflow",
    ],
)

ts_project(
    name = "interactions-conversation.test",
    testonly = True,
    srcs = ["interactions-conversation.test.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":script",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/common",
    ],
)

ts_project(
    name = "script",
    testonly = True,
    srcs = ["script.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        "//typescript/packages/worker:node_modules/@google/genai",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker/src/ai-sdks/google-genai-plugin:index",
    ],
)

ts_project(
    name = "tool-loop.test",
    testonly = True,
    srcs = ["tool-loop.test.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":agents",
        ":script",
        "//typescript/packages/worker:node_modules/@temporalio/client",
        "//typescript/packages/worker:node_modules/@temporalio/worker",
        "//typescript/packages/worker/src:index",
        "//typescript/packages/worker/src/ai-sdks/google-genai-plugin:index",
        "//typescript/packages/worker/src/harness:agent-client",
        "//typescript/packages/worker/test:match",
        "//typescript/packages/worker/test:support",
    ],
)

harness_js_test(
    name = "errors_test",
    size = "small",
    data = [":errors.test"],
    entry_point = "errors.test.js",
)

harness_js_test(
    name = "interactions-activity_test",
    size = "small",
    data = [":interactions-activity.test"],
    entry_point = "interactions-activity.test.js",
)

harness_js_test(
    name = "interactions-conversation_test",
    size = "small",
    data = [":interactions-conversation.test"],
    entry_point = "interactions-conversation.test.js",
)

harness_js_test(
    name = "tool-loop_test",
    data = [":tool-loop.test"],
    entry_point = "tool-loop.test.js",
)

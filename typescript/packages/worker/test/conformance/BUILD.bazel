load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# The scripted integration conformance/README.md describes, the twin of
# python/tests/conformance/scripted_agent.py. The driver is Python's:
# //python/tests/conformance:test_typescript_goldens plays every scenario against :worker.

ts_project(
    name = "script",
    testonly = True,
    srcs = ["script.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = ["//typescript/packages/worker:node_modules/zod"],
)

# The worker bundles the compiled scripted-agent.js, so it and the node_modules it imports are
# runfiles of :worker.
ts_project(
    name = "scripted-agent",
    testonly = True,
    srcs = ["scripted-agent.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":script",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/workflow",
        "//typescript/packages/worker:node_modules/zod",
    ],
)

ts_project(
    name = "worker_main",
    testonly = True,
    srcs = ["worker.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    deps = [
        ":scripted-agent",
        "//typescript/packages/worker/src:index",
    ],
)

# worker --address HOST:PORT --namespace NS --task-queue QUEUE (or TEMPORAL_ADDRESS,
# TEMPORAL_NAMESPACE, TEMPORAL_TASK_QUEUE): a worker hosting the scripted agent until SIGTERM.
js_binary(
    name = "worker",
    testonly = True,
    data = [":worker_main"],
    entry_point = "worker.js",
    visibility = ["//python/tests/conformance:__pkg__"],
)

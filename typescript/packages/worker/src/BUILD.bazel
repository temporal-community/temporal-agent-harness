load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# One target per file, depending on the files it imports, so a change reruns only the tests that
# reach it.
ts_project(
    name = "index",
    srcs = ["index.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":plugin",
        "//typescript/packages/worker:node_modules/@temporalio/worker",
        "//typescript/packages/worker/src/ai-sdks/jev:evaluator",
        "//typescript/packages/worker/src/harness:agent-workflow",
        "//typescript/packages/worker/src/harness:subagent-activities",
        "//typescript/packages/worker/src/harness/code-mode:activity-fs",
        "//typescript/packages/worker/src/utils:large-payload",
        "//typescript/packages/worker/src/web:client",
    ],
)

ts_project(
    name = "plugin",
    srcs = ["plugin.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//typescript/packages/worker:node_modules/@temporalio/activity",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/common",
        "//typescript/packages/worker:node_modules/@temporalio/plugin",
        "//typescript/packages/worker:node_modules/@temporalio/worker",
        "//typescript/packages/worker/src/ai-sdks/jev:evaluator",
        "//typescript/packages/worker/src/harness:subagent-activities",
        "//typescript/packages/worker/src/harness/code-mode:activity-fs",
        "//typescript/packages/worker/src/utils:large-payload",
    ],
)

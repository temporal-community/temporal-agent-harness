load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# One target per file, depending on the files it imports, so a change reruns only the tests that
# reach it.
ts_project(
    name = "activity-fs",
    srcs = ["activity-fs.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":okf",
        "//typescript/packages/worker:node_modules/@temporalio/activity",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/zod",
    ],
)

ts_project(
    name = "monty-stepper",
    srcs = ["monty-stepper.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":secret",
        "//typescript/packages/worker:node_modules/@pydantic/monty",
        "//typescript/packages/worker:node_modules/@temporalio/activity",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker/src:index",
    ],
)

ts_project(
    name = "okf",
    srcs = ["okf.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/yaml",
    ],
)

ts_project(
    name = "secret",
    srcs = ["secret.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
)

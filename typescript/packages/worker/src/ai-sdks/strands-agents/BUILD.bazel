load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# The worker half of the vendored Strands Agents integration. One target per file, depending on
# the files it imports, so a change reruns only the tests that reach it.

ts_project(
    name = "heartbeat-decorator",
    srcs = ["heartbeat-decorator.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = ["//typescript/packages/worker:node_modules/@temporalio/activity"],
)

ts_project(
    name = "index",
    srcs = ["index.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [":plugin"],
)

ts_project(
    name = "model-activity",
    srcs = ["model-activity.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":heartbeat-decorator",
        "//typescript/packages/worker:node_modules/@strands-agents/sdk",
        "//typescript/packages/worker:node_modules/@temporalio/activity",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/common",
        "//typescript/packages/worker:node_modules/@temporalio/workflow-streams",
        "//typescript/packages/worker/src/ai-sdks/integration-helpers:stream-observer",
    ],
)

ts_project(
    name = "plugin",
    srcs = ["plugin.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":model-activity",
        ":temporal-mcp-client",
        "//typescript/packages/worker:node_modules/@strands-agents/sdk",
        "//typescript/packages/worker:node_modules/@temporalio/activity",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/common",
        "//typescript/packages/worker:node_modules/@temporalio/plugin",
        "//typescript/packages/worker:node_modules/@temporalio/worker",
        "//typescript/packages/worker/src/ai-sdks/integration-helpers:stream-observer",
    ],
)

ts_project(
    name = "temporal-mcp-client",
    srcs = ["temporal-mcp-client.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//typescript/packages/worker:node_modules/@strands-agents/sdk",
        "//typescript/packages/worker:node_modules/@temporalio/activity",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
    ],
)

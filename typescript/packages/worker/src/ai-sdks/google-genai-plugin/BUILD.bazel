load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# One target per file, depending on the files it imports, so a change reruns only the tests that
# reach it.
ts_project(
    name = "errors",
    srcs = ["errors.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = ["//typescript/packages/worker:node_modules/@temporalio/activity"],
)

ts_project(
    name = "google-genai-plugin",
    srcs = ["google-genai-plugin.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":interactions-activity",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/plugin",
    ],
)

ts_project(
    name = "index",
    srcs = ["index.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":errors",
        ":google-genai-plugin",
        ":interactions-activity",
    ],
)

ts_project(
    name = "interactions-activity",
    srcs = ["interactions-activity.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":errors",
        "//typescript/packages/worker:node_modules/@google/genai",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/common",
        "//typescript/packages/worker/src/ai-sdks/integration-helpers:stream-observer",
        "//typescript/packages/worker/src/harness:agent-workflow",
    ],
)

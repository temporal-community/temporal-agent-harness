load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# One target per file, depending on the files it imports, so a change reruns only the tests that
# reach it.
ts_project(
    name = "index",
    srcs = ["index.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":invoke-model-activity",
        ":mcp",
        ":temporal-openai-agents",
        "//typescript/packages/worker:node_modules/@temporalio/openai-agents",
    ],
)

ts_project(
    name = "invoke-model-activity",
    srcs = ["invoke-model-activity.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//typescript/packages/worker:node_modules/@openai/agents-core",
        "//typescript/packages/worker:node_modules/@temporalio/activity",
        "//typescript/packages/worker:node_modules/@temporalio/agent-harness",
        "//typescript/packages/worker:node_modules/@temporalio/common",
        "//typescript/packages/worker:node_modules/openai",
        "//typescript/packages/worker:node_modules/zod",
        "//typescript/packages/worker/src/ai-sdks:openai-agents-harness",
        "//typescript/packages/worker/src/ai-sdks/integration-helpers:stream-observer",
    ],
)

ts_project(

load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# One target per file, depending on the files it imports, so a change reruns only the tests that
# reach it.
ts_project(
    name = "large-payload",
    srcs = ["large-payload.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//typescript/packages/worker:node_modules/@temporalio/common",
        "//typescript/packages/worker:node_modules/@temporalio/workflow-streams",
    ],
)

ts_project(
    name = "s3",
    srcs = ["s3.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/worker:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":large-payload",
        "//typescript/packages/worker:node_modules/@aws-sdk/client-s3",
        "//typescript/packages/worker:node_modules/@temporalio/common",
        "//typescript/packages/worker:node_modules/@temporalio/external-storage-s3",
        "//typescript/packages/worker:node_modules/@temporalio/external-storage-s3-aws-sdk",
    ],
)

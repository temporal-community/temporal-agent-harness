{
  "name": "@temporalio/agent-harness-codegen",
  "version": "0.5.0",
  "type": "module",
  "description": "Generate TypeScript types for a temporal-agent-harness agent from its `temporal-agent-harness schema` document.",
  "bin": {
    "harness-codegen": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --outDir dist && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "json-schema-to-typescript": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "files": [
    "dist/src"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temporal-community/temporal-agent-harness.git",
    "directory": "typescript/packages/codegen"
  }
}

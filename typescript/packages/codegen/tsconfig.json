{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": true,

    // Source imports carry `.ts` extensions and are rewritten to `.js` on emit, so the same
    // files typecheck in place and run as compiled JavaScript under plain Node ESM. No outDir:
    // Bazel emits beside the sources, so a test package finds the sources' declarations; the
    // package scripts pass `--outDir dist`.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src", "test"]
}

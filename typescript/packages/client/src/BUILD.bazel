# The event protocol's types, protocol.ts, generated from the committed contract
# (contract/protocol.schema.json), so building the client needs no Python:
# `bazel run //typescript/packages/client/src:protocol_codegen_update` rewrites it.
harness_types(
    name = "protocol_codegen",
    src = "protocol.ts",
    codegen_args = ["--protocol"],
    schema = "//contract:protocol_files",
)

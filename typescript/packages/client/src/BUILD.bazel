load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//bazel:codegen.bzl", "harness_types")

# One target per file, depending on the files it imports, so a change reruns only the tests that
# reach it.
ts_project(
    name = "frames",
    srcs = ["frames.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/client:tsconfig",
    visibility = ["//visibility:public"],
    deps = [":protocol"],
)

ts_project(
    name = "index",
    srcs = ["index.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/client:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":frames",
        ":jsonPatch",
        ":messages",
        ":plainState",
        ":projection",
        ":protocol",
        ":schema",
        ":session",
        ":start",
        ":transport",
        ":views",
    ],
)

ts_project(
    name = "jsonPatch",
    srcs = ["jsonPatch.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/client:tsconfig",
    visibility = ["//visibility:public"],
    deps = [":frames"],
)

ts_project(
    name = "messages",
    srcs = ["messages.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/client:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":frames",
        ":schema",
    ],
)

ts_project(
    name = "plainState",
    srcs = ["plainState.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/client:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":frames",
        ":messages",
        ":schema",
        ":session",
        ":views",
    ],
)

ts_project(
    name = "projection",

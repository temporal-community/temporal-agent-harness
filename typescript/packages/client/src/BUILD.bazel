    declaration = True,
    tsconfig = "//typescript/packages/client:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":frames",
        ":jsonPatch",
        ":messages",
    ],
)

ts_project(
    name = "protocol",
    srcs = ["protocol.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/client:tsconfig",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "schema",
    srcs = ["schema.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/client:tsconfig",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "session",
    srcs = ["session.ts"],

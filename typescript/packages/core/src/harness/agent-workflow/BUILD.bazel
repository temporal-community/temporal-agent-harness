load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# One target per file, depending on the files it imports, so a change reruns only the tests that
# reach it.

ts_project(
    name = "errors",
    srcs = ["errors.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/core:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//typescript/packages/core:node_modules/@temporalio/workflow",
        "//typescript/packages/core/src/harness/agent-protocol:index",
        "//typescript/packages/core/src/harness/state:index",
    ],
)

ts_project(
    name = "types",
    srcs = ["types.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/core:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//typescript/packages/core:node_modules/zod",
        "//typescript/packages/core/src/ai-sdks/integration-helpers:raw-events",
        "//typescript/packages/core/src/harness/agent-protocol:index",
        "//typescript/packages/core/src/harness/state:index",
    ],
)

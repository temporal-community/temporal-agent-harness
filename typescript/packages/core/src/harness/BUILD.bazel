load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# One target per file, depending on the files it imports, so a change reruns only the tests that
# reach it.

ts_project(
    name = "agent-schema",
    srcs = ["agent-schema.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/core:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":agent",
        "//typescript/packages/core/src/harness/agent-protocol:index",
    ],
)


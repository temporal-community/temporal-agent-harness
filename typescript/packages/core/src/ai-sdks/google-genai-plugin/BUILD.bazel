load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# One target per file, depending on the files it imports, so a change reruns only the tests that
# reach it. Every @google/genai import here is type-only: the workflow sandbox never loads the SDK.

ts_project(
    name = "index",
    srcs = ["index.ts"],
    declaration = True,
    tsconfig = "//typescript/packages/core:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":interactions-conversation",
        ":interactions-models",
        ":interactions-workflow",
        ":temporal-async-client",
        ":temporal-interactions",
        ":workflow",
    ],
)


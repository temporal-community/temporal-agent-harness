    visibility = ["//visibility:public"],
    deps = [
        "//typescript/packages/core:node_modules/@openai/agents-core",
        "//typescript/packages/core:node_modules/@temporalio/openai-agents",
        "//typescript/packages/core:node_modules/@temporalio/workflow",
        "//typescript/packages/core/src/harness:agent-workflow",
        "//typescript/packages/core/src/harness/agent-protocol:index",
        "//typescript/packages/core/src/harness/agent-workflow:errors",
        "//typescript/packages/core/src/harness/agent-workflow:types",

{
  "name": "temporal-agent-harness-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Alex Tideman",
  "scripts": {
    "build:sdk": "pnpm --dir ../../packages/client run build && pnpm --dir ../../packages/svelte run build",
    "predev": "pnpm run build:sdk",
    "prebuild": "pnpm run build:sdk",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "precheck": "pnpm run build:sdk",
    "check": "svelte-check --tsconfig ./tsconfig.json && vitest run",
    "pretest": "pnpm run build:sdk",
    "test": "vitest run",
    "pretest:watch": "pnpm run build:sdk",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/svelte": "^1.0.1",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/highlight": "^1.1.0",
    "@tanstack/markdown": "1.0.0",
    "@tanstack/pacer": "0.23.1",
    "@tanstack/svelte-virtual": "3.13.47",
    "@temporalio/agent-harness-svelte": "workspace:^",
    "@xyflow/svelte": "^1.6.0",
    "d3-force": "^3.0.0",
    "remend": "^1.4.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.4",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "5.0.1"
  }
}

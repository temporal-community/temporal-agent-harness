# The whole tsconfig project type-checked together, as the `check` script's svelte-check does.
svelte_check_bin.svelte_check_test(
    name = "svelte_check_test",
    args = [
        "--tsconfig",
        "./tsconfig.json",
    ],
    chdir = package_name(),
    data = [
        ":config",
        ":node_modules",
        ":sources",
        # The event protocol's types, which src/lib/api/types.ts imports by path (type-only, so
        # no source target depends on it).
        "//typescript/packages/client/src:protocol",
    ],
    # Its declarations, which a test's runfiles leave out by default.
    include_types = True,
)

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//typescript/apps/ui:svelte-check/package_json.bzl", svelte_check_bin = "bin")
load("@npm//typescript/apps/ui:vite/package_json.bzl", vite_bin = "bin")

npm_link_all_packages(name = "node_modules")

# The page, which a test also reads.
js_library(
    name = "index_html",
    srcs = ["index.html"],
    visibility = ["//typescript/apps/ui:__subpackages__"],
)

# What vite, vitest and svelte-check read from the package root.
js_library(
    name = "config",
    srcs = [
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts",
    ],
    deps = [
        ":node_modules/@sveltejs/vite-plugin-svelte",
        ":node_modules/svelte",
        ":node_modules/vite",
    ],
)

# The console's production build, which python/temporal_agent_harness/ui/dist commits: the page,
# what its entry module imports, and public/, which vite copies as it is.
vite_bin.vite(
    name = "dist",
    srcs = [
        ":config",
        ":index_html",
        "//typescript/apps/ui/public:favicon",
        "//typescript/apps/ui/public:temporal-logo",
        "//typescript/apps/ui/src:main",
    ],
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
    visibility = ["//python/temporal_agent_harness/ui:__pkg__"],
)

# What vitest reads from the package root. vitest_test (bazel/vitest.bzl) adds it to every test,
# which takes visibility from //bazel.
js_library(
    name = "vitest_config",
    srcs = ["vitest.config.ts"],
    visibility = ["//bazel:__pkg__"],
    deps = [
        ":config",
        ":node_modules/vitest",
    ],
)


load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//bazel:vitest.bzl", "vitest_test")

# One target per file, depending on the files it imports.
js_library(
    name = "index",
    srcs = ["index.ts"],
    visibility = ["//typescript/apps/ui:__subpackages__"],
    deps = [
        ":primitives",
        ":theme-dark",
        ":theme-light",
        ":types",
    ],
)

js_library(
    name = "primitives",
    srcs = ["primitives.ts"],
    visibility = ["//typescript/apps/ui:__subpackages__"],
)

js_library(
    name = "theme-dark",
    srcs = ["theme-dark.ts"],
    visibility = ["//typescript/apps/ui:__subpackages__"],
    deps = [
        ":primitives",
        ":types",
    ],
)

js_library(
    name = "theme-light",
    srcs = ["theme-light.ts"],
    visibility = ["//typescript/apps/ui:__subpackages__"],
    deps = [
        ":primitives",
        ":types",
    ],
)

js_library(
    name = "types",
    srcs = ["types.ts"],
    visibility = ["//typescript/apps/ui:__subpackages__"],
)

# One target per test file, depending on what it imports and the files it reads by path.
vitest_test(
    name = "index_test",
    src = "index.test.ts",
    deps = [":index"],
)

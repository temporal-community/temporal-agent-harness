    deps = [
        ":inputClearDissolve",
        "//typescript/apps/ui/src:app",
        "//typescript/apps/ui/src/lib/components/agent:TranscriptPanel",
        "//typescript/apps/ui/src/lib/components/chat:SessionControls",
        "//typescript/apps/ui/src/lib/components/chat:StartSessionDialog",

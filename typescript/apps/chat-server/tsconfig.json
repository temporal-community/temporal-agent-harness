{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    // Declarations let the tests compile as their own Bazel project, against the sources' types.
    "declaration": true,

    // Cards and modals are authored as JSX against Chat SDK's own runtime (`chat/jsx-runtime`).
    "jsx": "react-jsx",
    "jsxImportSource": "chat",

    // Source imports carry `.ts` extensions and are rewritten to `.js` on emit, so the same
    // files typecheck in place and run as compiled JavaScript under plain Node ESM. No outDir:
    // Bazel emits beside the sources, so a test package finds the sources' declarations; the
    // package scripts pass `--outDir dist`. This Node build has no TypeScript stripping, so
    // tests compile first rather than running from source.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src", "test"]
}

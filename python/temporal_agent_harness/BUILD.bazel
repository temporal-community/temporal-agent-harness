load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:committed_files.bzl", "committed_files")

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = [".."],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "plugin",
    srcs = ["plugin.py"],
    imports = [".."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//python/temporal_agent_harness/harness:subagent_activities",
        "//python/temporal_agent_harness/harness/code_mode:__init__",
        "//python/temporal_agent_harness/harness/code_mode:activity_fs",
        "//python/temporal_agent_harness/utils:large_payload",
        "@pypi//temporalio",
    ],
)

# The published package: its entry points, the modules nothing else in the package imports.
# Everything they reach under temporal_agent_harness/, with the console their data brings, is what
# the wheel and sdist ship (//python:dists). scripts/check-python-package-entry-points.sh fails
# while a library in the package is outside this target's dependencies.
py_library(
    name = "temporal_agent_harness",  # keep
    data = [":development_resources"],  # keep
    visibility = [
        "//python:__pkg__",
        "//python/tests:__pkg__",
    ],
    deps = [
        ":__init__",
        "//python/temporal_agent_harness/ai_sdks:__init__",
        "//python/temporal_agent_harness/ai_sdks:pydantic_ai_harness",
        "//python/temporal_agent_harness/ai_sdks:strands_agents_harness",
        "//python/temporal_agent_harness/ai_sdks:typesafe_harness",
        "//python/temporal_agent_harness/ai_sdks/google_genai_plugin:__init__",
        "//python/temporal_agent_harness/ai_sdks/jev:__init__",
        "//python/temporal_agent_harness/ai_sdks/openai_agents",
        "//python/temporal_agent_harness/harness:__init__",
        "//python/temporal_agent_harness/nexus_agent_adapter:__init__",
        "//python/temporal_agent_harness/nexus_agent_adapter:worker_lib",
        "//python/temporal_agent_harness/utils:__init__",
        "//python/temporal_agent_harness/web:cli_lib",
    ],
)

filegroup(
    name = "development_resources",
    srcs = glob(
        ["skills/**"],
        exclude = ["skills/**/BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

py_library(
    name = "development",
    srcs = ["development.py"],
    data = [":development_resources"],  # keep
    imports = [".."],
    visibility = ["//python:__subpackages__"],
)

committed_files(
    name = "shared_skill_files",
    srcs = [
        "skills/temporal-harness-python/assets/starter/env.example.tmpl",
        "skills/temporal-harness-python/assets/starter/gitignore.tmpl",
        "skills/temporal-harness-python/references/api.md",
        "skills/temporal-harness-python/references/verification.md",
    ],
    generated = {
        "skills/temporal-harness-python/assets/starter/env.example.tmpl": "//docs:agent-resources/env.example.tmpl",
        "skills/temporal-harness-python/assets/starter/gitignore.tmpl": "//docs:agent-resources/gitignore.tmpl",
        "skills/temporal-harness-python/references/api.md": "//docs:api/README.md",
        "skills/temporal-harness-python/references/verification.md": "//docs:agent-resources/verification.md",
    },
)

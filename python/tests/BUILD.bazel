# Imports _activity_fs_parent by bare name, so its directory goes on sys.path as under
# `uv run pytest`.
agent_kit_pytest_test(
    name = "test_activity_filesystem",
    srcs = ["test_activity_filesystem.py"],
    imports = [".."],
    pytest_args = [
        "-o",
        "pythonpath='. tests'",  # one token: Bazel shell-splits args
    ],
    deps = [
        ":_activity_fs_parent",
        ":conftest",
        "//python/temporal_agent_kit:agent",
        "//python/temporal_agent_kit:agent_client",
        "//python/temporal_agent_kit:plugin",
        "//python/temporal_agent_kit/agent_protocol:__init__",
        "//python/temporal_agent_kit/code_mode:activity_fs",
        "//python/temporal_agent_kit/code_mode:vfs",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//temporalio",
    ],
)

# Loads every example agent by module path (the `# keep` deps), except the Nexus one, which
# Bazel does not build; CI runs that case outside Bazel (the pytest-outside-bazel job in
# .github/workflows/tests.yml).
agent_kit_pytest_test(
    name = "test_agent_schema",
    srcs = ["test_agent_schema.py"],
    data = ["//python/examples/tictactoe:agents_files"],
    imports = [".."],
    pytest_args = ["--deselect=tests/test_agent_schema.py::test_every_example_agent_has_a_deterministic_self_contained_schema[examples.nexus_hello.workflow:NexusHelloAgentWorkflow]"],
    deps = [
        ":conftest",
        "//python/examples/auto_mode:workflow",  # keep
        "//python/examples/callback_tools/coding_agent:workflow",  # keep
        "//python/examples/callback_tools/wiki_agent:workflow",  # keep
        "//python/examples/monty:conversational_subagent_workflow",  # keep
        "//python/examples/monty:conversational_workflow",  # keep
        "//python/examples/monty:workflow",  # keep
        "//python/examples/openai_hello:workflow",  # keep
        "//python/examples/pydantic_ai_hello:workflow",  # keep
        "//python/examples/react_agent:workflow",  # keep
        "//python/examples/strands_hello:workflow",  # keep
        "//python/examples/tictactoe:workflow",  # keep
        "//python/temporal_agent_kit:agent",
        "//python/temporal_agent_kit:agent_schema",
        "//python/temporal_agent_kit/agent_protocol:__init__",
        "//python/temporal_agent_kit/agent_protocol:events",
        "//python/temporal_agent_kit/state:__init__",
        "@pypi//pydantic",
        "@pypi//pytest",
    ],
)


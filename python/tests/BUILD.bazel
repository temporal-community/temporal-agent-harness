load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:pytest.bzl", "agent_kit_pytest_test")

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = [".."],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = [".."],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//temporalio"],
)

agent_kit_pytest_test(
    name = "test_packaged_distributions",
    srcs = ["test_packaged_distributions.py"],
    data = ["//python:dists"],
    env = {"PYTHON_DISTS": "$(rootpath //python:dists)"},
    imports = [".."],
    deps = [
        # The package's third-party dependencies, for importing the extracted wheel.
        "//python/temporal_agent_kit",  # keep
        ":conftest",
        "@pypi//pytest",
    ],
)


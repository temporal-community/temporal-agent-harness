load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:pytest.bzl", "harness_pytest_test")

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = [".."],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = [".."],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//temporalio"],
)

harness_pytest_test(
    name = "test_packaged_distributions",
    srcs = ["test_packaged_distributions.py"],
    data = ["//python:dists"],
    env = {"PYTHON_DISTS": "$(rootpath //python:dists)"},
    imports = [".."],
    deps = [
        # The package's third-party dependencies, for importing the extracted wheel.
        "//python/temporal_agent_harness",  # keep
        ":conftest",
        "@pypi//pytest",
    ],
)

py_library(
    name = "fixture_cli_agent",
    srcs = ["fixture_cli_agent.py"],
    imports = [".."],
    visibility = ["//python:__subpackages__"],
    deps = [
        "//python/temporal_agent_harness/harness:agent",
        "//python/temporal_agent_harness/harness:agent_workflow",
        "//python/temporal_agent_harness/harness/agent_protocol:__init__",
        "//python/temporal_agent_harness/harness/agent_protocol:events",
        "@pypi//pydantic",
        "@pypi//temporalio",
    ],
)

harness_pytest_test(
    name = "test_agent_cli",
    srcs = ["test_agent_cli.py"],
    imports = [".."],
    deps = [
        ":conftest",
        ":fixture_cli_agent",
        "//python/temporal_agent_harness:agent_cli",
        "//python/temporal_agent_harness:agent_cli_ui",
        "//python/temporal_agent_harness:plugin",
        "//python/temporal_agent_harness/harness:agent_client",
        "//python/temporal_agent_harness/harness:agent_schema",
        "//python/temporal_agent_harness/harness/agent_protocol:__init__",
        "//python/temporal_agent_harness/harness/agent_protocol:events",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//rich",
        "@pypi//temporalio",
    ],
)

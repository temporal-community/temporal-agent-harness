{
  // For type-checking App.svelte against the generated client types. The page itself is never
  // built; `svelte`, the binding and the client resolve through typescript/packages/svelte's
  // install.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "svelte": ["../../../../typescript/packages/svelte/node_modules/svelte"],
      "svelte/*": ["../../../../typescript/packages/svelte/node_modules/svelte/*"],
      "@temporalio/agent-harness-svelte": ["../../../../typescript/packages/svelte/src/lib/index.ts"]
    }
  },
  "include": ["App.svelte"]
}

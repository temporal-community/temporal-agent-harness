load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:agents.bzl", "harness_agent", "harness_agent_registry")
load("//bazel:binary.bzl", "harness_module_binary")

harness_module_binary(
    name = "client",
    srcs = ["client.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//httpx"],
)

py_library(
    name = "human_tools",
    srcs = ["human_tools.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = ["//python/temporal_agent_harness/harness:agent"],
)

py_library(
    name = "tool_activities",
    srcs = ["tool_activities.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//python/temporal_agent_harness/harness:agent",
        "@pypi//httpx",
        "@pypi//temporalio",
    ],
)

harness_module_binary(
    name = "worker",
    srcs = ["worker.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":human_tools",
        ":tool_activities",
        ":workflow",
        "//python/temporal_agent_harness:plugin",
        "//python/temporal_agent_harness/ai_sdks:openai_agents_harness",
        "//python/temporal_agent_harness/ai_sdks/openai_agents",
        "@pypi//openai_agents",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "workflow",
    srcs = ["workflow.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":human_tools",
        ":tool_activities",
        "//python/temporal_agent_harness/ai_sdks:openai_agents_harness",
        "//python/temporal_agent_harness/ai_sdks/openai_agents",
        "//python/temporal_agent_harness/harness:agent",
        "//python/temporal_agent_harness/harness:agent_workflow",
        "//python/temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//openai_agents",
        "@pypi//temporalio",
    ],
)

harness_agent(
    name = "ReactAgent",
    agent = "examples.react_agent.workflow:ReactAgentWorkflow",
    description = """
A ReAct-style agent on the OpenAI Agents SDK: it reasons, then acts by chaining real tools,
looping on each result until it can answer. Chat in plain text and it finds the weather for a
named city (coordinates -> weather) or your current location (IP -> location -> weather), and
pulls Formula 1 data over an MCP server — chaining tools as needed and replying in prose. Shows
the harness OpenAI streaming path with a multi-tool agentic loop end to end — model call →
streaming activity → live turn stream (reply_delta / tool_requested / tool_start / tool_end /
model_interaction_*).""",
    key = "react-agent",
    label = "ReAct Agent",
    task_queue = "react-agent",
    deps = [":workflow"],
)

# agents.toml and its agents' schema documents. `bazel test` fails when one is out of date;
# `bazel run //python/examples/react_agent:agents_update` rewrites them.
harness_agent_registry(
    name = "agents",
    srcs = [
        "ReactAgent.schema.json",
        "agents.toml",
    ],
    agents = [":ReactAgent"],
)

harness_agent(
    name = "EvalDispatcher",
    agent = "examples.swarm_eval.eval_agents:EvalDispatcher",
    description = """
Evaluate a configured agent with a small swarm. Send `evaluate` to write cases, run conversations,
and grade them against tool evidence. Defaults to Monty's travel agent with 16 cases, two active
conversations, and one judge. Supply target and profile for another agent. `export` returns full
run evidence for the incubation CLI; `simulate: true` exercises the loop with no API keys.
Needs the swarm search attributes (the root `just temporal` registers them).""",
    key = "swarm-eval",
    label = "Eval Swarm",
    task_queue = "swarm-eval",
    deps = [":eval_agents"],
)

# agents.toml and the dispatcher's schema document. The other agents are started by a run, never
# as sessions of their own, so the registry does not list them. `bazel test` fails when one is out
# of date; `bazel run //python/examples/swarm_eval:agents_update` rewrites them.
harness_agent_registry(
    name = "agents",
    srcs = [
        "EvalDispatcher.schema.json",
        "agents.toml",
    ],
    agents = [":EvalDispatcher"],
    visibility = ["//python/tests/web:__pkg__"],
)


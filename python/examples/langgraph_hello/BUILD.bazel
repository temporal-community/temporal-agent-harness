load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:agents.bzl", "harness_agent", "harness_agent_registry")
load("//bazel:binary.bzl", "harness_module_binary")

harness_module_binary(
    name = "worker",
    srcs = ["worker.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":workflow",
        "//python/temporal_agent_harness:plugin",
        "//python/temporal_agent_harness/ai_sdks/langgraph:__init__",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "workflow",
    srcs = ["workflow.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//python/temporal_agent_harness/ai_sdks/langgraph:__init__",
        "//python/temporal_agent_harness/harness:agent",
        "//python/temporal_agent_harness/harness:agent_workflow",
        "//python/temporal_agent_harness/harness/agent_protocol:__init__",
        "//python/temporal_agent_harness/harness/state:__init__",
        "@pypi//langchain_core",
        "@pypi//langchain_openai",
        "@pypi//langgraph",
        "@pypi//langgraph_checkpoint",
        "@pypi//langgraph_prebuilt",
        "@pypi//temporalio",
    ],
)

harness_agent(
    name = "LangGraphHelloAgent",
    agent = "examples.langgraph_hello.workflow:LangGraphHelloAgentWorkflow",
    description = """
A hello-world LangGraph agent. Chat in plain text: it reports a city's weather (get_weather, an
activity tool), remembers notes you give it (remember, an inline tool that writes its state and
waits for your approval), and asks you back when a request is ambiguous (ask_user, a callback
tool). Sent while it works, a message steers it. Shows the harness streaming path for the
LangGraph integration end to end — model node activity → harness observer → live turn stream.""",
    key = "langgraph-hello",
    label = "LangGraph Hello",
    task_queue = "langgraph-hello",
    deps = [":workflow"],
)

# agents.toml and its agents' schema documents. `bazel test` fails when one is out of date;
# `bazel run //python/examples/langgraph_hello:agents_update` rewrites them.
harness_agent_registry(
    name = "agents",
    srcs = [
        "LangGraphHelloAgent.schema.json",
        "agents.toml",
    ],
    agents = [":LangGraphHelloAgent"],
    visibility = ["//python/tests/web:__pkg__"],
)

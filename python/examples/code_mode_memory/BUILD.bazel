load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:agents.bzl", "agent_kit_agent", "agent_kit_agent_registry")
load("//bazel:binary.bzl", "agent_kit_module_binary")

py_library(
    name = "local_disk",
    srcs = ["local_disk.py"],
    # SkillsDisk serves the skills folder.
    data = glob(["skills/**"]),
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//python/temporal_agent_kit:agent",
        "@pypi//pydantic",
    ],
)

agent_kit_module_binary(
    name = "worker",
    srcs = ["worker.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":local_disk",
        ":workflow",
        "//python/temporal_agent_kit:plugin",
        "//python/temporal_agent_kit/ai_sdks/google_genai_plugin:__init__",
        "//python/temporal_agent_kit/utils:task_queue",
        "@pypi//google_genai",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "workflow",
    srcs = ["workflow.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":local_disk",
        "//python/temporal_agent_kit:agent",
        "//python/temporal_agent_kit:agent_workflow",
        "//python/temporal_agent_kit/agent_protocol:__init__",
        "//python/temporal_agent_kit/ai_sdks/google_genai_plugin:__init__",
        "//python/temporal_agent_kit/code_mode:vfs",
        "@pypi//google_genai",
        "@pypi//pydantic",
        "@pypi//temporalio",
    ],
)

agent_kit_agent(
    name = "CodeModeMemoryAgent",
    agent = "examples.code_mode_memory.workflow:CodeModeMemoryAgentWorkflow",
    description = """
An assistant with long-term memory: its Code Mode scripts keep /memory as an OKF knowledge
bundle in a directory of the worker's disk, following a memory skill under /skills. Start two
sessions with the same memory_dir and the second one remembers what you told the first; open
the Graph in the VFS File Mounts pane to see how the memories link up.""",
    key = "code-mode-memory",
    label = "Code Mode Memory",
    task_queue = "code-mode-memory",
    deps = [":workflow"],
)

# agents.toml and its agents' schema documents. `bazel test` fails when one is out of date;
# `bazel run //python/examples/code_mode_memory:agents_update` rewrites them.
agent_kit_agent_registry(
    name = "agents",
    srcs = [
        "CodeModeMemoryAgent.schema.json",
        "agents.toml",
    ],
    agents = [":CodeModeMemoryAgent"],
    visibility = ["//python/tests/web:__pkg__"],
)

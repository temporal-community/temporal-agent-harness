harness_agent(
    name = "GovernedAnalyticsAgent",
    agent = "examples.governed_analytics.workflow:GovernedAnalyticsAgentWorkflow",
    description = """
A bank analyst over three DuckDB databases, composing a fixed set of data tools in Code Mode.
Every tool call is checked by a Dogwood tool policy first: analytics data is open, risk data
needs a time-boxed lease you grant, and customer PII is never readable.""",
    key = "governed-analytics",
    label = "Governed analytics (Dogwood policy)",
    task_queue = "governed-analytics-agent",
    deps = [":workflow"],
)

# agents.toml and its agent's schema document. `bazel test` fails when one is out of date;
# `bazel run //python/examples/governed_analytics:agents_update` rewrites them.
harness_agent_registry(
    name = "agents",
    srcs = [
        "GovernedAnalyticsAgent.schema.json",
        "agents.toml",
    ],
    agents = [":GovernedAnalyticsAgent"],
    visibility = ["//python/tests/web:__pkg__"],
)


    visibility = ["//python:__subpackages__"],
    deps = [
        "//python/temporal_agent_harness/harness:agent",
        "@pypi//pydantic",
    ],
)

# The agent's typed TypeScript client, client_sdk/GovernedAnalyticsAgent.ts, for the studio (ui/):
# `bazel run //python/examples/governed_analytics:client_sdk_update` rewrites it.
harness_client_sdk(
    name = "client_sdk",
    srcs = ["client_sdk/GovernedAnalyticsAgent.ts"],
    agents = [":GovernedAnalyticsAgent"],
    visibility = [":__subpackages__"],
)


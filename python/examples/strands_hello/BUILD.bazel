load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:agents.bzl", "harness_agent", "harness_agent_registry")
load("//bazel:binary.bzl", "harness_module_binary")

# Strands' OpenAIModel imports `openai`, which the worker never imports by name (the `# keep` dep).
harness_module_binary(
    name = "worker",
    srcs = ["worker.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":workflow",
        "//python/temporal_agent_harness:plugin",
        "//python/temporal_agent_harness/ai_sdks:strands_agents_harness",
        "//python/temporal_agent_harness/ai_sdks/strands_agents:__init__",
        "//python/temporal_agent_harness/utils:task_queue",
        "@pypi//openai",  # keep
        "@pypi//strands_agents",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "workflow",
    srcs = ["workflow.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//python/temporal_agent_harness/ai_sdks:strands_agents_harness",
        "//python/temporal_agent_harness/ai_sdks/strands_agents:__init__",
        "//python/temporal_agent_harness/harness:agent",
        "//python/temporal_agent_harness/harness:agent_workflow",
        "//python/temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//temporalio",
    ],
)

harness_agent(
    name = "StrandsHelloAgent",
    agent = "examples.strands_hello.workflow:StrandsHelloAgentWorkflow",
    description = """
A hello-world Strands Agents agent. Chat in plain text; it replies in prose and uses every kind
of tool a harness Strands agent takes: get_weather (inline), get_local_time (activity), ask_user
(callback: it asks you and waits), and a scratch sandbox's sandbox_shell / sandbox_file_editor
(each call waits for your approval). Shows the harness streaming path for the Strands
integration end to end — model call → observer in the Strands model activity → live turn stream.""",
    key = "strands-hello",
    label = "Strands Hello",
    task_queue = "strands-hello",
    deps = [":workflow"],
)

# agents.toml and its agents' schema documents. `bazel test` fails when one is out of date;
# `bazel run //python/examples/strands_hello:agents_update` rewrites them.
harness_agent_registry(
    name = "agents",
    srcs = [
        "StrandsHelloAgent.schema.json",
        "agents.toml",
    ],
    agents = [":StrandsHelloAgent"],
    visibility = ["//python/tests/web:__pkg__"],
)

load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:agents.bzl", "harness_agent", "harness_agent_registry")
load("//bazel:binary.bzl", "harness_module_binary")

harness_module_binary(
    name = "worker",
    srcs = ["worker.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":workflow",
        "//python/examples/monty:activities",
        "//python/temporal_agent_harness:plugin",
        "//python/temporal_agent_harness/ai_sdks/google_genai_plugin:__init__",
        "@pypi//google_genai",
        "@pypi//temporalio",
        "@pypi//temporalio_typesafe",
        "@pypi//typesafe_sdk",
    ],
)

py_library(
    name = "workflow",
    srcs = ["workflow.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//python/examples/monty:activities",
        "//python/examples/monty:trip_board",
        "//python/temporal_agent_harness/ai_sdks/google_genai_plugin:__init__",
        "//python/temporal_agent_harness/ai_sdks/jev:__init__",
        "//python/temporal_agent_harness/harness:agent",
        "//python/temporal_agent_harness/harness:agent_workflow",
        "//python/temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//google_genai",
        "@pypi//pydantic",
        "@pypi//temporalio",
    ],
)

harness_agent(
    name = "AutoModeTravelAgent",
    agent = "examples.auto_mode.workflow:AutoModeTravelAgentWorkflow",
    description = """
The Monty conversational travel agent under AUTO MODE: each gated tool call is first judged
by Jev against named criteria sets — lookups are approved, bookings are escalated to you, and
anything Jev isn't sure about comes to you exactly as it would without auto mode.""",
    key = "auto-mode-travel",
    label = "Travel agent (Jev Auto mode)",
    task_queue = "auto-mode-agent",
    deps = [":workflow"],
)

# agents.toml and its agents' schema documents. `bazel test` fails when one is out of date;
# `bazel run //python/examples/auto_mode:agents_update` rewrites them.
harness_agent_registry(
    name = "agents",
    srcs = [
        "AutoModeTravelAgent.schema.json",
        "agents.toml",
    ],
    agents = [":AutoModeTravelAgent"],
    visibility = ["//python/tests/web:__pkg__"],
)

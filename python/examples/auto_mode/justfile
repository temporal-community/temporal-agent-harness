# Scoped justfile for the auto-mode example (examples/auto_mode).
# Run from this directory: `just <recipe>`.
#
# Self-contained local stack (each in its own terminal):
#   just temporal          # 1. local Temporal dev server (or bring your own)
#   just session-manager   # 2. packaged session-manager worker
#   just server            # 3. FastAPI API + UI on :8000
#   just worker            # 4. this example's agent worker
#
# The recipes build and run each program with Bazel (install bazelisk as `bazel`), which fetches the
# project's `examples` dependencies on first use. Without Bazel, run the same module with uv from
# the repo root, e.g. `PYTHONPATH=python uv run --project python --group examples python -m
# examples.auto_mode.worker`. First-time setup: `cp .env.example .env.local` from the repo root and
# fill it in (Temporal connection + GEMINI_API_KEY + TYPESAFE_API_KEY). See README.md.

# Shows a notice when running from an untagged commit (silent on a release archive).
import '../../../scripts/untagged-notice.just'

# Read the single shared env file at the repo root (resolved relative to this justfile).
set dotenv-path := "../../../.env.local"
set dotenv-load := true

root := justfile_directory() / ".." / ".." / ".."
ui := root / "typescript" / "apps" / "ui"
# pnpm as Bazel pins it, on Bazel's Node (//typescript:pnpm): no recipe needs Node or pnpm on
# the machine.
pnpm := "bazel run --noshow_progress --ui_event_filters=-info --show_result=0 //typescript:pnpm --"

# List available recipes (bare `just`).
default:
    @just --list

# Show the Temporal connection these recipes will use (read from the repo-root .env.local).
config:
    @echo "TEMPORAL_CONFIG_FILE = ${TEMPORAL_CONFIG_FILE:-<unset — set it in the repo-root .env.local>}"
    @echo "TEMPORAL_PROFILE     = ${TEMPORAL_PROFILE:-default}"

# Start a local Temporal dev server (Web UI: http://localhost:8233; needs the `temporal` CLI).
temporal:
    temporal server start-dev

# Run the packaged session-manager worker (`temporal-agent-harness session-manager`).
session-manager:
    bazel run //python/temporal_agent_harness/web:cli -- session-manager

# Serve the Svelte UI + FastAPI API on http://localhost:8000, pointed at this example's registry.
# Serves the COMMITTED UI build, so this needs no Node/pnpm.
server:
    bazel run //python/temporal_agent_harness/web:cli -- serve "{{justfile_directory()}}/agents.toml" --host 0.0.0.0 --port 8000

# Run the Svelte UI on Vite for hot reloading. /api is proxied to the FastAPI server on :8000.
ui-dev:
    {{pnpm}} --dir "{{ui}}" install --frozen-lockfile
    {{pnpm}} --dir "{{ui}}" run dev

# Run the auto-mode agent worker (needs GEMINI_API_KEY and TYPESAFE_API_KEY).
worker:
    bazel run //python/examples/auto_mode:worker

# The session manager, `server`, and `worker` in one terminal, against a running Temporal (`just
# temporal`). Ctrl-C stops them all.
#
# Run this example's local stack.
dev:
    just --justfile "{{root}}/justfile" dev auto_mode

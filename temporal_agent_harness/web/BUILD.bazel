load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:binary.bzl", "harness_module_binary")

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":app",
        ":registry",
        ":session_manager",
        ":session_manager_worker",
    ],
)

py_library(
    name = "agent_starts",
    srcs = ["agent_starts.py"],
    visibility = ["//:__subpackages__"],
    deps = [":session_manager"],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":agent_starts",
        ":file_view",
        ":registry",
        ":session_manager",
        ":task_queue_status",
        "//temporal_agent_harness:plugin",
        "//temporal_agent_harness/harness:agent_client",
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "//temporal_agent_harness/ui:__init__",
        "//temporal_agent_harness/utils:large_payload",
        "@pypi//fastapi",
        "@pypi//pydantic",
        "@pypi//temporalio",
    ],
)

harness_module_binary(
    name = "cli",
    srcs = ["cli.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":client",
        ":serve",
        ":session_manager",
        ":session_manager_worker",
        "//temporal_agent_harness/harness:agent_schema",
    ],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//temporal_agent_harness:plugin",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "file_view",
    srcs = ["file_view.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//temporal_agent_harness/harness/code_mode:activity_fs",
        "//temporal_agent_harness/harness/code_mode:okf",
        "//temporal_agent_harness/harness/code_mode:vfs",
        "@pypi//pydantic",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "registry",
    srcs = ["registry.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":session_manager",
        "//temporal_agent_harness/harness:agent_schema",
    ],
)

py_library(
    name = "serve",
    srcs = ["serve.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":__init__",
        ":client",
        ":registry",
        "@pypi//fastapi",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "session_manager",
    srcs = ["session_manager.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "session_manager_worker",
    srcs = ["session_manager_worker.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":client",
        ":session_manager",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "task_queue_status",
    srcs = ["task_queue_status.py"],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//temporalio"],
)

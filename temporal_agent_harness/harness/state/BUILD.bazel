load("@aspect_rules_py//py:defs.bzl", "py_library")

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":base",
        ":decl",
        ":drafts",  # keep
        ":errors",
        ":events",
        ":ref",
    ],
)

py_library(
    name = "base",
    srcs = ["base.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":containers",
        ":errors",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "containers",
    srcs = ["containers.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":errors",
        ":session",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "decl",
    srcs = ["decl.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":base",
        ":ref",
    ],
)

py_library(
    name = "drafts",
    srcs = ["drafts.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":base",
        ":containers",
        ":errors",
        ":session",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "errors",
    srcs = ["errors.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "events",
    srcs = ["events.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "ref",
    srcs = ["ref.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":base",
        ":drafts",
        ":errors",
        ":events",
        ":session",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "session",
    srcs = ["session.py"],
    visibility = ["//:__subpackages__"],
    deps = [":errors"],
)

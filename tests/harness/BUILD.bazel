load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:pytest.bzl", "harness_pytest_test")

py_library(
    name = "_activity_fs_parent",
    srcs = ["_activity_fs_parent.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//temporal_agent_harness/harness:agent",
        "//temporal_agent_harness/harness:agent_workflow",
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//pydantic",
        "@pypi//temporalio",
    ],
)

# Imports _activity_fs_parent by bare name, so its directory goes on sys.path as under
# `uv run pytest`.
harness_pytest_test(
    name = "test_activity_filesystem",
    srcs = ["test_activity_filesystem.py"],
    pytest_args = [
        "-o",
        "pythonpath='. tests/harness'",  # one token: Bazel shell-splits args
    ],
    deps = [
        ":_activity_fs_parent",
        "//temporal_agent_harness:plugin",
        "//temporal_agent_harness/harness:agent",
        "//temporal_agent_harness/harness:agent_client",
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "//temporal_agent_harness/harness/code_mode:activity_fs",
        "//temporal_agent_harness/harness/code_mode:vfs",
        "//tests:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//temporalio",
    ],
)

# Loads every example agent by module path (the `# keep` deps), except the Nexus one, which
# Bazel does not build; CI runs that case outside Bazel (the pytest-outside-bazel job in
# .github/workflows/tests.yml).
harness_pytest_test(
    name = "test_agent_schema",
    srcs = ["test_agent_schema.py"],
    data = ["//examples/tictactoe:agents_files"],
    pytest_args = ["--deselect=tests/harness/test_agent_schema.py::test_every_example_agent_has_a_deterministic_self_contained_schema[examples.nexus_hello.workflow:NexusHelloAgentWorkflow]"],
    deps = [
        "//examples/auto_mode:workflow",  # keep
        "//examples/callback_tools/coding_agent:workflow",  # keep
        "//examples/callback_tools/wiki_agent:workflow",  # keep
        "//examples/monty:conversational_subagent_workflow",  # keep
        "//examples/monty:conversational_workflow",  # keep
        "//examples/monty:workflow",  # keep
        "//examples/openai_hello:workflow",  # keep
        "//examples/pydantic_ai_hello:workflow",  # keep
        "//examples/react_agent:workflow",  # keep
        "//examples/tictactoe:workflow",  # keep
        "//temporal_agent_harness/harness:agent",
        "//temporal_agent_harness/harness:agent_schema",
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "//temporal_agent_harness/harness/agent_protocol:events",
        "//temporal_agent_harness/harness/state:__init__",
        "//tests:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
    ],
)


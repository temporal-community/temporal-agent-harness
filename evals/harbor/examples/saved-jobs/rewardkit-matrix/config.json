{
  "job_name": "rewardkit-matrix",
  "n_concurrent_trials": 1,
  "verifier": {
    "env": {
      "HARNESS_EVAL_JUDGE": "1",
      "OPENAI_API_KEY": "${OPENAI_API_KEY}",
      "REWARDKIT_JUDGE": "openai/gpt-5.1"
    }
  },
  "agents": [
    {
      "import_path": "harness_evals.adapter:TemporalHarnessAgent",
      "kwargs": {
        "workflow_type": "OpenAIHelloAgent",
        "task_queue": "openai-hello",
        "address": "127.0.0.1:17323",
        "namespace": "default"
      }
    },
    {
      "import_path": "harness_evals.adapter:TemporalHarnessAgent",
      "kwargs": {
        "workflow_type": "PydanticAIHelloAgent",
        "task_queue": "pydantic-ai-hello",
        "address": "127.0.0.1:17323",
        "namespace": "default"
      }
    }
  ],
  "tasks": [
    {
      "path": "tasks/weather"
    },
    {
      "path": "tasks/greeting"
    }
  ]
}

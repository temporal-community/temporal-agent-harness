py_library(
    name = "workflow",
    srcs = ["workflow.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//temporal_agent_harness/ai_sdks:typesafe_harness",
        "//temporal_agent_harness/harness:agent",
        "//temporal_agent_harness/harness:agent_workflow",
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//pydantic",
        "@pypi//temporalio",
        "@pypi//typesafe_sdk",
    ],
)

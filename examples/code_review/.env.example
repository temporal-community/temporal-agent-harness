# OpenAI-compatible LiteLLM gateway URL, including its API prefix.
LITELLM_BASE_URL=http://localhost:4000/v1
# A model alias advertised by your LiteLLM gateway. Required; no built-in vendor default.
LITELLM_MODEL=your-model-alias
# Optional gateway key, not a direct OpenAI/provider key. Leave empty for an unauthenticated gateway.
LITELLM_API_KEY=
# Optional per-agent model aliases; blank values inherit LITELLM_MODEL.
LITELLM_COORDINATOR_MODEL=
LITELLM_CORRECTNESS_MODEL=
LITELLM_SECURITY_MODEL=
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=code-review-demo

# LiteLLM OpenAI-compatible gateway URL, including the API prefix.
LITELLM_BASE_URL=https://litellm.tmprl-internal.com/v1
# Default model in LiteLLM provider/model syntax.
LITELLM_MODEL=openai/gpt-6-luna
# The coordinator and OpenAI Agents reviewer use GPT-6 Luna.
LITELLM_COORDINATOR_MODEL=openai/gpt-6-luna
LITELLM_CORRECTNESS_MODEL=openai/gpt-6-luna
# The Pydantic AI reviewer uses Claude Sonnet 5.5.
LITELLM_SECURITY_MODEL=anthropic/claude-sonnet-5-5
# Export LITELLM_API_KEY in your shell, or add it here if your gateway requires it.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=code-review-demo

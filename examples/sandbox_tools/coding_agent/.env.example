# Environment for the sandboxed coding agent example.
# Copy to the repo-root .env.local (the justfile loads that file):
#
#     cp examples/sandbox_tools/coding_agent/.env.example .env.local
#
# Then fill in OPENAI_API_KEY below.

OPENAI_API_KEY=

# "local" (default) runs sandboxed tools in-process on the worker — no msb/E2B required.
# Set to "microsandbox" for microVM execution (needs snapshot: just build-sandbox).
SANDBOX_BACKEND=local

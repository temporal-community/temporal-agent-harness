load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:agents.bzl", "harness_agent", "harness_agent_registry")
load("//bazel:binary.bzl", "harness_module_binary")

harness_module_binary(
    name = "worker",
    srcs = ["worker.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":workflow",
        "//temporal_agent_harness:plugin",
        "//temporal_agent_harness/ai_sdks:openai_agents_harness",
        "//temporal_agent_harness/ai_sdks/openai_agents",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "workflow",
    srcs = ["workflow.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//temporal_agent_harness/ai_sdks:openai_agents_harness",
        "//temporal_agent_harness/harness:agent",
        "//temporal_agent_harness/harness:agent_workflow",
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//openai_agents",
        "@pypi//temporalio",
    ],
)

harness_agent(
    name = "OpenAIHelloAgent",
    agent = "examples.openai_hello.workflow:OpenAIHelloAgentWorkflow",
    description = """
A hello-world OpenAI Agents SDK agent. Chat in plain text; it replies in prose and can
call one tool (get_weather) for a city's weather. Exists to show the harness streaming
path for the OpenAI integration end to end — model call → streaming activity → live turn
stream (reply_delta / tool_requested / tool_start / tool_end / model_interaction_*).""",
    key = "openai-hello",
    label = "OpenAI Hello",
    task_queue = "openai-hello",
    deps = [":workflow"],
)

# agents.toml and its agents' schema documents. `bazel test` fails when one is out of date;
# `bazel run //examples/openai_hello:agents_update` rewrites them.
harness_agent_registry(
    name = "agents",
    srcs = [
        "OpenAIHelloAgent.schema.json",
        "agents.toml",
    ],
    agents = [":OpenAIHelloAgent"],
)

# Scoped justfile for the tic-tac-toe TypeSafe example (examples/tictactoe).
# Run from this directory: `just <recipe>`.
#
# Self-contained local stack (each in its own terminal):
#   just temporal          # 1. local Temporal dev server (or bring your own)
#   just session-manager   # 2. packaged session-manager worker
#   just server            # 3. FastAPI API + UI on :8000
#   just worker            # 4. this example's agent worker
#   just play              # 5. optional: the Svelte board on http://127.0.0.1:5173
#
# uv installs the project's `examples` dependency group (incl. the TypeSafe SDK) on demand, so
# there's no separate install step. First-time setup: `cp .env.example .env.local` from the
# repo root and fill it in (Temporal connection + TYPESAFE_API_KEY). See README.md.

# Shows a notice when running from an untagged commit (silent on a release archive).
import '../../scripts/untagged-notice.just'

# Read the single shared env file at the repo root (resolved relative to this justfile).
set dotenv-path := "../../.env.local"
set dotenv-load := true

root := justfile_directory() / ".." / ".."
ui := root / "ui"

# List available recipes (bare `just`).
default:
    @just --list

# Show the Temporal connection these recipes will use (read from the repo-root .env.local).
config:
    @echo "TEMPORAL_CONFIG_FILE = ${TEMPORAL_CONFIG_FILE:-<unset — set it in the repo-root .env.local>}"
    @echo "TEMPORAL_PROFILE     = ${TEMPORAL_PROFILE:-default}"

# Start a local Temporal dev server (Web UI: http://localhost:8233; needs the `temporal` CLI).
temporal:
    temporal server start-dev

# Run the packaged session-manager worker (`temporal-agent-harness session-manager`).
session-manager:
    cd "{{root}}" && uv run --group examples temporal-agent-harness session-manager

# Serve the Svelte UI + FastAPI API on http://localhost:8000, pointed at this example's registry.
# Serves the COMMITTED UI build, so this needs no Node/pnpm.
server:
    cd "{{root}}" && uv run --group examples temporal-agent-harness serve "{{justfile_directory()}}/agents.toml" --host 0.0.0.0 --port 8000

# Run the Svelte UI on Vite for hot reloading. /api is proxied to the FastAPI server on :8000.
ui-dev:
    pnpm --dir "{{ui}}" run dev

# Serve the Svelte board (ui/) on http://127.0.0.1:5173. The page has no build step (the browser
# compiles App.svelte); Node only builds the harness packages it imports.
# Needs `just server` + `just worker` running for it to talk to.
# TODO: once @temporal-agent-harness/{client,svelte} are published to npm, drop the build and the
# links below and point ui/index.html's import map at a CDN instead.
play:
    @cd "{{root}}/packages/client" && npm ci --prefer-offline --no-audit --no-fund --silent && npm run --silent build
    @cd "{{root}}/packages/svelte" && npm ci --prefer-offline --no-audit --no-fund --silent && npm run --silent build >/dev/null
    @ln -sfn "{{root}}/packages/client/dist" ui/harness-client
    @ln -sfn "{{root}}/packages/svelte/dist" ui/harness-svelte
    @cd ui && python3 -u -m http.server 5173 --bind 127.0.0.1 2>/dev/null

# Type-check ui/App.svelte against the generated client types (after `just play` has installed
# packages/svelte).
check-ui:
    cd "{{justfile_directory()}}/ui" && "{{root}}/packages/svelte/node_modules/.bin/svelte-check" --tsconfig ./tsconfig.json

# Run the tic-tac-toe agent worker.
worker:
    cd "{{root}}" && uv run --group examples python -m examples.tictactoe.worker

# Regenerate the agent's TypeScript client types, client_sdk/TicTacToeAgent.ts, from its Python
# handler and state models. Needs Node. CI fails when the committed file is out of date.
codegen-client-sdk:
    cd "{{root}}/packages/codegen" && npm ci --prefer-offline --no-audit --no-fund && npm run --silent build
    cd "{{root}}" && uv run --group examples temporal-agent-harness schema examples.tictactoe.workflow:TicTacToeAgentWorkflow \
        | node packages/codegen/dist/src/cli.js - -o "{{justfile_directory()}}/client_sdk/TicTacToeAgent.ts"

load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:agents.bzl", "harness_agent", "harness_agent_registry")
load("//bazel:binary.bzl", "harness_module_binary")

py_library(
    name = "local_disk",
    srcs = ["local_disk.py"],
    # SkillsDisk serves the skills folder.
    data = glob(["skills/**"]),
    visibility = ["//:__subpackages__"],
    deps = [
        "//temporal_agent_harness/harness:agent",
        "@pypi//pydantic",
    ],
)

harness_module_binary(
    name = "worker",
    srcs = ["worker.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":local_disk",
        ":workflow",
        "//temporal_agent_harness:plugin",
        "//temporal_agent_harness/ai_sdks/google_genai_plugin:__init__",
        "@pypi//google_genai",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "workflow",
    srcs = ["workflow.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":local_disk",
        "//temporal_agent_harness/ai_sdks/google_genai_plugin:__init__",
        "//temporal_agent_harness/harness:agent",
        "//temporal_agent_harness/harness:agent_workflow",
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "//temporal_agent_harness/harness/code_mode:vfs",
        "@pypi//google_genai",
        "@pypi//pydantic",
        "@pypi//temporalio",
    ],
)

harness_agent(
    name = "CodeModeMemoryAgent",
    agent = "examples.code_mode_memory.workflow:CodeModeMemoryAgentWorkflow",
    description = """
An assistant with long-term memory: its Code Mode scripts keep /memory as an OKF knowledge
bundle in a directory of the worker's disk, following a memory skill under /skills. Start two
sessions with the same memory_dir and the second one remembers what you told the first; open
the Graph in the VFS File Mounts pane to see how the memories link up.""",
    key = "code-mode-memory",
    label = "Code Mode Memory",
    task_queue = "code-mode-memory",
    deps = [":workflow"],
)

# agents.toml and its agents' schema documents. `bazel test` fails when one is out of date;
# `bazel run //examples/code_mode_memory:agents_update` rewrites them.
harness_agent_registry(
    name = "agents",
    srcs = [
        "CodeModeMemoryAgent.schema.json",
        "agents.toml",
    ],
    agents = [":CodeModeMemoryAgent"],
)

load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:agents.bzl", "harness_agent", "harness_agent_registry")
load("//bazel:binary.bzl", "harness_module_binary")

harness_module_binary(
    name = "client",
    srcs = ["client.py"],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//httpx"],
)

py_library(
    name = "tools",
    srcs = ["tools.py"],
    visibility = ["//:__subpackages__"],
    deps = ["//temporal_agent_harness/harness:agent"],
)

harness_module_binary(
    name = "worker",
    srcs = ["worker.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":workflow",
        "//temporal_agent_harness:plugin",
        "//temporal_agent_harness/ai_sdks/google_genai_plugin:__init__",
        "@pypi//google_genai",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "workflow",
    srcs = ["workflow.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":tools",
        "//temporal_agent_harness/ai_sdks/google_genai_plugin:__init__",
        "//temporal_agent_harness/harness:agent",
        "//temporal_agent_harness/harness:agent_workflow",
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//google_genai",
        "@pypi//temporalio",
    ],
)

harness_agent(
    name = "WikiAgent",
    agent = "examples.callback_tools.wiki_agent.workflow:WikiAgentWorkflow",
    description = """
A conversational agent that organizes a tree of Markdown files into a personal wiki. Tell it
things to remember or ask it to tidy up; an LLM decides when to create, append to, or delete
notes and calls read_file / write_file / ls / tree / delete_file / grep. Those are CALLBACK
tools: the agent has no disk of its own, so a thin client on your machine executes each call
against a local wiki directory and returns the result.""",
    key = "wiki",
    label = "Wiki Keeper (Callback Tools)",
    task_queue = "wiki-agent",
    deps = [":workflow"],
)

# agents.toml and its agents' schema documents. `bazel test` fails when one is out of date;
# `bazel run //examples/callback_tools/wiki_agent:agents_update` rewrites them.
harness_agent_registry(
    name = "agents",
    srcs = [
        "WikiAgent.schema.json",
        "agents.toml",
    ],
    agents = [":WikiAgent"],
)

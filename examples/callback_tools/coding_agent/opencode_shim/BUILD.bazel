load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:binary.bzl", "harness_module_binary")

py_library(
    name = "_identifiers",
    srcs = ["_identifiers.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "_time",
    srcs = ["_time.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "backend",
    srcs = ["backend.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":_identifiers",  # keep
        ":_time",
        ":state",
        "//examples/callback_tools/coding_agent/opencode_shim/models:__init__",
    ],
)

py_library(
    name = "harness_backend",
    srcs = ["harness_backend.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":backend",
        ":local_tools",  # keep
        "@pypi//httpx",
    ],
)

py_library(
    name = "local_tools",
    srcs = ["local_tools.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":_identifiers",  # keep
        ":_time",
        ":backend",
        ":local_tools",  # keep
        ":state",
        "//examples/callback_tools/coding_agent/opencode_shim/models:__init__",
        "@pypi//fastapi",
    ],
)

py_library(
    name = "state",
    srcs = ["state.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//examples/callback_tools/coding_agent/opencode_shim/models:__init__",
        "//examples/callback_tools/coding_agent/opencode_shim/models:base",
    ],
)

harness_module_binary(
    name = "opencode_shim_bin",
    srcs = ["__main__.py"],
    main = "__main__.py",
    visibility = ["//:__subpackages__"],
    deps = [
        ":harness_backend",
        ":server",
        "@pypi//uvicorn",
    ],
)

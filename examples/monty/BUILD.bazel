load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:agents.bzl", "harness_agent", "harness_agent_registry")
load("//bazel:binary.bzl", "harness_module_binary")

py_library(
    name = "activities",
    srcs = ["activities.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":travel_models",
        "//temporal_agent_harness/harness:agent",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "conversational_subagent_workflow",
    srcs = ["conversational_subagent_workflow.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":conversational_workflow",
        ":workflow",
        "//temporal_agent_harness/ai_sdks/google_genai_plugin:__init__",
        "//temporal_agent_harness/harness:agent",
        "//temporal_agent_harness/harness:agent_workflow",
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//google_genai",
        "@pypi//pydantic",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "conversational_workflow",
    srcs = ["conversational_workflow.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":activities",  # keep
        ":trip_board",  # keep
        "//temporal_agent_harness/ai_sdks/google_genai_plugin:__init__",
        "//temporal_agent_harness/harness:agent",
        "//temporal_agent_harness/harness:agent_workflow",
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//google_genai",
        "@pypi//pydantic",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "travel_models",
    srcs = ["travel_models.py"],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "trip_board",
    srcs = ["trip_board.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//temporal_agent_harness/harness:agent",
        "//temporal_agent_harness/harness/state:__init__",
        "@pypi//pydantic",
        "@pypi//temporalio",
    ],
)

harness_module_binary(
    name = "worker",
    srcs = ["worker.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":activities",  # keep
        ":conversational_subagent_workflow",
        ":conversational_workflow",
        ":workflow",
        "//temporal_agent_harness:plugin",
        "//temporal_agent_harness/ai_sdks/google_genai_plugin:__init__",
        "@pypi//google_genai",
        "@pypi//temporalio",
    ],
)

py_library(
    name = "workflow",
    srcs = ["workflow.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":activities",  # keep
        ":models",
        ":trip_board",  # keep
        "//temporal_agent_harness/harness:agent",
        "//temporal_agent_harness/harness:agent_workflow",
        "//temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//temporalio",
    ],
)

harness_agent(
    name = "MontyChatAgent",
    agent = "examples.monty.conversational_workflow:MontyChatAgentWorkflow",
    description = """
A conversational travel-booking assistant. Chat in plain text; an LLM converses to
gather your trip details, then WRITES its own pydantic-monty Python script and runs
it via a tool to orchestrate durable flight/hotel search + booking activities,
replying with the results.""",
    key = "monty-chat",
    label = "Monty (Conversational)",
    task_queue = "monty-dynamic-agent",
    deps = [":conversational_workflow"],
)

harness_agent(
    name = "MontyChatSubagentAgent",
    agent = "examples.monty.conversational_subagent_workflow:MontyChatSubagentWorkflow",
    description = """
Same conversational travel-booking experience as Monty (Conversational), but instead
of running its Python scripts inline it drives the barebones Monty (Dynamic) agent as
a SUBAGENT — starting a script-runner instance and sending it each script over the
harness subagent toolset. The first end-to-end demo of agents-as-subagents.""",
    key = "monty-chat-subagent",
    label = "Monty (Conversational, Subagent)",
    task_queue = "monty-dynamic-agent",
    deps = [":conversational_subagent_workflow"],
)

# agents.toml and its agents' schema documents. `bazel test` fails when one is out of date;
# `bazel run //examples/monty:agents_update` rewrites them.
harness_agent_registry(
    name = "agents",
    srcs = [
        "MontyChatAgent.schema.json",
        "MontyChatSubagentAgent.schema.json",
        "agents.toml",
    ],
    agents = [
        ":MontyChatAgent",
        ":MontyChatSubagentAgent",
    ],
    visibility = ["//tests/web:__pkg__"],
)

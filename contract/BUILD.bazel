load("//bazel:agents.bzl", "agent_kit_schema")
load("//bazel:committed_files.bzl", "committed_files")

# The files both SDKs are tested against (contract/README.md). Python generates each of them for
# now; `bazel run //contract:<name>_update` rewrites one, and its `_up_to_date_test` fails while it
# differs from what Python writes.

# The event stream's wire types: `temporal-agent-kit schema --protocol`.
agent_kit_schema(
    name = "protocol_schema",
    args = [
        "schema",
        "--protocol",
    ],
)

committed_files(
    name = "protocol",
    srcs = ["protocol.schema.json"],
    generated = {"protocol.schema.json": ":protocol_schema"},
    visibility = [
        "//python/tests/conformance:__pkg__",
        "//typescript/packages/client/src:__pkg__",
    ],
)

# The agents.toml format, which every SDK's `serve` reads: `temporal-agent-kit schema
# --registry`.
agent_kit_schema(
    name = "registry_schema",
    args = [
        "schema",
        "--registry",
    ],
)

committed_files(
    name = "registry",
    srcs = ["registry.schema.json"],
    generated = {"registry.schema.json": ":registry_schema"},
    visibility = ["//python/tests/web:__pkg__"],
)

# The operations of the AgentKitRegistryStore Nexus service a server keeps its registry in with
# `serve --registry-store-endpoint`, which a store in any Temporal SDK implements:
# `temporal-agent-kit schema --registry-store`. registry-store.nexusrpc.yaml names them.
agent_kit_schema(
    name = "registry_store_schema",
    args = [
        "schema",
        "--registry-store",
    ],
)

committed_files(
    name = "registry_store",
    srcs = ["registry-store.schema.json"],
    generated = {"registry-store.schema.json": ":registry_store_schema"},
    visibility = ["//python/tests/web:__pkg__"],
)

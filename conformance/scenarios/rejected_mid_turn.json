{
  "description": "A run_reject message sent mid-turn is refused and publishes nothing.",
  "actions": [
    {
      "action": "send",
      "handler": "run_reject",
      "script": {
        "steps": [
          {
            "step": "tool",
            "id": "call-hold",
            "name": "ask_client",
            "args": {
              "question": "Continue?"
            }
          },
          {
            "step": "model",
            "reply": [
              "First."
            ]
          }
        ]
      }
    },
    {
      "action": "await",
      "event": "callback_requested",
      "tool_id": "call-hold"
    },
    {
      "action": "send",
      "handler": "run_reject",
      "script": {
        "steps": [
          {
            "step": "model",
            "reply": [
              "Never."
            ]
          }
        ]
      }
    },
    {
      "action": "answer_callback",
      "tool_id": "call-hold",
      "result": "Yes."
    }
  ]
}

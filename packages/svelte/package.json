    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.20.4",
    "happy-dom": "^20.14.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }

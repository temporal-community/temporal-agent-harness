{
  "name": "@temporal-agent-harness/svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Svelte 5 binding for @temporal-agent-harness/client: a reactive AgentSession over a temporal-agent-harness agent's event stream.",
  "exports": {

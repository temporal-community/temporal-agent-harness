load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@bazel_lib//lib:directory_path.bzl", "directory_path")
load("@npm_codegen//:defs.bzl", "npm_link_all_packages")
load("@npm_codegen//packages/codegen:typescript/package_json.bzl", typescript_bin = "bin")
load("//bazel:codegen.bzl", "harness_types")

npm_link_all_packages(name = "node_modules")

# `npm run build`: tsc emits src/ and test/ into dist/.
typescript_bin.tsc(
    name = "dist",
    srcs = glob([
        "src/**/*.ts",
        "test/**",
    ]) + [
        "package.json",
        "tsconfig.json",
        ":node_modules",
    ],
    args = [
        "-p",
        "tsconfig.json",
    ],
    chdir = package_name(),
    out_dirs = ["dist"],
)

directory_path(
    name = "cli_entry_point",
    directory = ":dist",
    path = "src/cli.js",
)

# harness-codegen: reads a `temporal-agent-harness schema` document and prints TypeScript types.
js_binary(
    name = "cli",
    data = [
        "package.json",
        ":dist",
        ":node_modules",
    ],
    entry_point = ":cli_entry_point",
    visibility = ["//visibility:public"],
)

directory_path(
    name = "test_entry_point",
    directory = ":dist",
    path = "test/generate.test.js",
)

# `npm test`: the generator against its golden, from the tic-tac-toe agent's committed schema.
js_test(
    name = "test",
    data = [
        "package.json",
        ":dist",
        ":node_modules",
        "//examples/tictactoe:agents_files",
    ] + glob(["test/golden/**"]),
    entry_point = ":test_entry_point",
)

# The generator's golden, test/golden/TicTacToeAgent.ts: the tic-tac-toe agent's types, which the
# tests compare and type-check. `bazel run //packages/codegen:golden_update` rewrites it.
harness_types(
    name = "golden",
    src = "test/golden/TicTacToeAgent.ts",
    schema = "//examples/tictactoe:TicTacToeAgent",
)

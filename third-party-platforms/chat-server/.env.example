# Environment for the OPTIONAL chat-platform front end. Copy to `.env.local` (gitignored) in
# THIS directory and edit it:
#
#     cp .env.example .env.local
#
# Self-contained on purpose: nothing here belongs in the repo-root .env.local, and the harness
# never reads this file. `just run` loads it automatically.

# --- Which agent this bot speaks for ----------------------------------------------------------
# An `AgentDescriptor.key` from `GET /api/agents` — e.g. monty-chat, react-agent, tictactoe.
# Check what is actually available with:
#
#     curl -s localhost:8000/api/agents | jq -r '.agents[].key'
#
# For two bots addressing two different agents, map them by adapter instead:
#     BOT_AGENT_ROUTES=discord=monty-chat,slack=react-agent
BOT_AGENT_ROUTES=monty-chat

# --- How a plain message reaches the agent ----------------------------------------------------
# Talking to the bot is the primary interface; no slash command registration is needed anywhere.
#
#     @bot how is the deploy going      -> DEFAULT_HANDLER(DEFAULT_HANDLER_FIELD="how is ...")
#     @bot /help                        -> lists the agent's handlers
#     @bot /set_approval_policy p=x     -> calls that handler directly
#
# Which @agent.accepts handler un-prefixed text goes to, and which field of its input model the
# message body becomes. Most agents spell this `ask(TextMessage)` with a `text` field — but
# nothing in the harness enforces either name, so an agent whose entry point is
# `chat(prompt=...)` would set DEFAULT_HANDLER=chat and DEFAULT_HANDLER_FIELD=prompt.
# Check with: curl -s localhost:8000/api/agent-interface/<session_id> | jq
DEFAULT_HANDLER=ask
DEFAULT_HANDLER_FIELD=text

# Where the harness web app is. Leave blank for the `just server` default (:8000).
HARNESS_URL=

# Port this server listens on. Only Slack needs it reachable; Discord dials out.
PORT=

# debug | info | warn | error | silent. Default info. Use `debug` to trace every platform event
# through Chat SDK and this server — the first thing to reach for if the bot seems not to see
# your messages at all.
LOG_LEVEL=

# --- Discord ----------------------------------------------------------------------------------
# https://discord.com/developers/applications — see README.md for the click-by-click walkthrough.
# Setting DISCORD_BOT_TOKEN is what enables the Discord adapter.
#
# Discord connects over the Gateway (an outbound WebSocket), so NO public URL and no tunnel are
# needed. Two dashboard settings are load-bearing and easy to miss:
#   * Bot -> Privileged Gateway Intents -> MESSAGE CONTENT INTENT must be ON, or Discord
#     refuses the connection outright.
#   * General Information -> Interactions Endpoint URL must be EMPTY, or slash commands and
#     buttons are delivered over HTTP and the Gateway never sees them.

# Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# General Information -> Public Key. Only used to verify webhook signatures, but the adapter
# validates it at construction, so it must be set even in Gateway mode.
DISCORD_PUBLIC_KEY=

# General Information -> Application ID.
DISCORD_APPLICATION_ID=

# Set to 0 to serve Discord over the webhook route (/api/discord) instead of the Gateway. That
# is what a real deployment with a public URL does; for local testing, leave it blank.
DISCORD_GATEWAY=

# --- Slack ------------------------------------------------------------------------------------
# https://api.slack.com/apps — see README.md for the click-by-click walkthrough.
# Setting SLACK_BOT_TOKEN enables the Slack adapter.

# "Bot User OAuth Token" from OAuth & Permissions. Starts xoxb-.
SLACK_BOT_TOKEN=

# "Signing Secret" from Basic Information. Verifies webhook requests; unused in Socket Mode,
# but harmless to set and required the moment you switch to a public URL.
SLACK_SIGNING_SECRET=

# App-level token from Basic Information -> App-Level Tokens, with the connections:write scope.
# Starts xapp-. Setting it turns on SOCKET MODE, Slack's equivalent of Discord's Gateway: the
# bot dials out over a WebSocket and needs no public URL and no tunnel. Leave it blank to run
# Slack over webhooks instead, which needs a public HTTPS URL pointed at /api/slack.
SLACK_APP_TOKEN=

# Set to 0 to force webhook mode even when SLACK_APP_TOKEN is present.
SLACK_SOCKET_MODE=
